{
  "name": "pi-subagents",
  "version": "1.7.0",
  "license": "MIT",
  "type": "module",
  "description": "面向 Antigravity、Claude Code 与 Codex 的 Pi 多模型子代理调度平台（MCP 服务与实时 Web 调度台）",
  "author": "mumuxsy",
  "homepage": "https://github.com/mumuxsy/pi-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumuxsy/pi-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/mumuxsy/pi-subagents/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pi-coding-agent",
    "subagents",
    "multi-agent",
    "antigravity",
    "claude-code",
    "codex",
    "agent-orchestration",
    "sandbox"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "src/",
    "dashboard/",
    "extensions/",
    "scripts/",
    "docs/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dashboard": "node scripts/dashboard.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "install:all": "node scripts/install.js",
    "install:codex": "node scripts/install.js --target=codex",
    "install:claude": "node scripts/install.js --target=claude",
    "install:antigravity": "node scripts/install.js --target=antigravity",
    "uninstall:codex": "node scripts/install.js --target=codex --remove",
    "uninstall:claude": "node scripts/install.js --target=claude --remove",
    "uninstall:antigravity": "node scripts/install.js --target=antigravity --remove",
    "verify:communication": "node scripts/verify-communication.js",
    "verify:live": "node scripts/verify-live.js",
    "wait-events": "node scripts/wait-events.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "undici": "7.30.0",
    "zod": "3.25.76"
  }
}
